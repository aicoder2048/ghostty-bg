#!/usr/bin/env bash
# ghostty-bg — switch the Ghostty terminal background image with one command (macOS).
# ghostty-bg — 一条命令切换 Ghostty 终端背景图（macOS）。
#
# How it works: your Ghostty config includes a tiny file, background.ghostty,
# that holds a single `background-image = ...` line. ghostty-bg rewrites only that
# file, then sends SIGUSR2 to Ghostty, which makes Ghostty reload its config.
#
# Run `ghostty-bg help` for usage. 运行 `ghostty-bg help` 查看用法。
#
# Environment:
#   GHOSTTY_BG_LANG     zh | en — message language (default: from LC_ALL / LC_MESSAGES / LANG)
#   GHOSTTY_BG_CONFIG   path of the Ghostty config file to use (default: auto-detect)
#   GHOSTTY_BG_BLUR     0 = do not widen narrow images with blurred sides (default: on if ImageMagick is installed)

set -euo pipefail

VERSION="1.22.0"
INCLUDE_NAME="background.ghostty"
INCLUDE_LINE="config-file = ?$INCLUDE_NAME"
INCLUDE_RE="^[[:space:]]*config-file[[:space:]]*=[[:space:]]*\"?\??\"?$INCLUDE_NAME"

# ---------- language ----------

detect_lang() {
  case "${GHOSTTY_BG_LANG:-}" in
    zh*|ZH*) echo zh; return ;;
    en*|EN*) echo en; return ;;
  esac
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    zh*) echo zh ;;
    *)   echo en ;;
  esac
}
UI_LANG="$(detect_lang)"

# msg "<English>" "<中文>" — print the text in the current language.
msg() { if [[ "$UI_LANG" == zh ]]; then echo "$2"; else echo "$1"; fi; }
die() { echo "ghostty-bg: $(msg "$1" "$2")" >&2; exit 1; }

[[ "$(uname -s)" == "Darwin" ]] || die "ghostty-bg supports macOS only." "ghostty-bg 只支持 macOS。"

# ---------- locating files ----------

# On macOS, Ghostty reads its config from both of these folders
# (the newer file name config.ghostty first, then the legacy name config).
candidate_configs() {
  local xdg="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
  local mac="$HOME/Library/Application Support/com.mitchellh.ghostty"
  echo "$xdg/config.ghostty"
  echo "$xdg/config"
  echo "$mac/config.ghostty"
  echo "$mac/config"
}

# Prefer a config that already includes background.ghostty, then any existing config.
find_config() {
  if [[ -n "${GHOSTTY_BG_CONFIG:-}" ]]; then
    echo "$GHOSTTY_BG_CONFIG"
    return
  fi
  local c first=""
  while IFS= read -r c; do
    [[ -f "$c" ]] || continue
    if grep -qE "$INCLUDE_RE" "$c"; then
      echo "$c"
      return
    fi
    [[ -n "$first" ]] || first="$c"
  done < <(candidate_configs)
  if [[ -n "$first" ]]; then
    echo "$first"
  else
    # No config yet: create one in the folder Ghostty's own "Open Config" uses.
    echo "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  fi
}

CONFIG_FILE="$(find_config)"
CONFIG_DIR="$(dirname "$CONFIG_FILE")"
LIB_DIR="$CONFIG_DIR/backgrounds"
BG_CONF="$CONFIG_DIR/$INCLUDE_NAME"

is_initialized() {
  [[ -f "$CONFIG_FILE" ]] && grep -qE "$INCLUDE_RE" "$CONFIG_FILE"
}

require_init() {
  is_initialized || die "not set up yet — run: ghostty-bg init" "还没设置——请先运行：ghostty-bg init"
}

# ---------- reloading Ghostty ----------

reload_ghostty() {
  # Ghostty reloads its config when it receives SIGUSR2.
  # Match the exact process name (-x). Do NOT use -f: other processes may carry
  # the Ghostty path in their arguments, and SIGUSR2 terminates most programs.
  # -a is required: macOS pgrep skips its own ancestors by default. When this script
  # runs inside Ghostty, Ghostty IS an ancestor, so without -a it is never found.
  # Every running Ghostty instance gets the signal.
  local pids
  pids="$(pgrep -a -x ghostty || true)"
  if [[ -n "$pids" ]]; then
    # shellcheck disable=SC2086  # word splitting is intended: one PID per word
    kill -USR2 $pids 2>/dev/null && return 0
  fi
  msg "(Could not reload Ghostty automatically — press cmd+shift+, in Ghostty to reload the config.)" \
      "（没能自动重新加载——请在 Ghostty 里按 cmd+shift+, 重新加载配置。）"
}

# ---------- library ----------

list_images() {
  [[ -d "$LIB_DIR" ]] || return 0
  find "$LIB_DIR" -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) | sort
}

current_image() {
  [[ -f "$BG_CONF" ]] || return 0
  sed -n 's/^background-image = "\(.*\)"$/\1/p' "$BG_CONF"
}

# Opacity set by ghostty-bg (in background.ghostty); empty if not set there.
managed_opacity() {
  [[ -f "$BG_CONF" ]] || return 0
  # The viewing mode (bgv) shows the image at full opacity and notes the real
  # setting in a comment. If bgv was killed before it could restore the file,
  # that comment is what counts, so the next command puts things right.
  if grep -q '^# view-mode$' "$BG_CONF"; then
    sed -n 's/^# view-opacity = \([0-9.]*\)$/\1/p' "$BG_CONF"
    return
  fi
  sed -n 's/^background-image-opacity = \([0-9.]*\)$/\1/p' "$BG_CONF"
}

# The opacity Ghostty actually uses: background.ghostty is loaded after the main
# config, so its value wins; then the main config; then Ghostty's default (1).
effective_opacity() {
  local v
  v="$(managed_opacity)"
  if [[ -z "$v" && -f "$CONFIG_FILE" ]]; then
    v="$(sed -n 's/^[[:space:]]*background-image-opacity[[:space:]]*=[[:space:]]*\([0-9.]*\).*$/\1/p' "$CONFIG_FILE" | tail -1)"
  fi
  echo "${v:-1}"
}

# The image that was showing before `bgh` / `bgs off` hid it (kept as a comment,
# so Ghostty ignores it); empty if the background is not hidden.
hidden_image() {
  [[ -f "$BG_CONF" ]] || return 0
  sed -n 's/^# hidden-image = "\(.*\)"$/\1/p' "$BG_CONF"
}

# ---------- image shape ----------

# Images narrower than this width/height ratio count as "narrow" (portrait or
# square). Filling a wide window with them (fit = cover) would crop off most of
# the picture, so they are shown whole instead (fit = contain).
NARROW_RATIO="1.2"

# Print width/height of an image (macOS sips, no extra tools needed).
image_ratio() {
  sips -g pixelWidth -g pixelHeight "$1" 2>/dev/null |
    awk '/pixelWidth/ { w = $2 } /pixelHeight/ { h = $2 } END { if (h > 0) printf "%.4f", w / h }'
}

is_narrow() {
  local r
  r="$(image_ratio "$1")"
  [[ -n "$r" ]] && awk -v r="$r" -v t="$NARROW_RATIO" 'BEGIN { exit !(r < t) }'
}

# Rewrite background.ghostty.
# $1: image path ("" = no image), $2: opacity ("" = not set),
# $3: image to remember while hidden ("" = none).
# A narrow image also gets `background-image-fit = contain`, so it is shown
# whole instead of cropped; wide images keep the fit from the main config.
write_include() {
  # The effect shader survives every rewrite (switching, opacity, hide...) unless
  # cmd_fx sets FX_NEXT: a path to use, or "" to turn the effect off.
  # The theme line survives the same way; cmd_theme sets THEME_NEXT ("" = none).
  local fx theme
  fx="${FX_NEXT-$(managed_fx)}"
  theme="${THEME_NEXT-$(managed_theme)}"
  {
    echo '# Managed by ghostty-bg — do not edit by hand. Run `bgs help` for commands.'
    [[ -n "$1" ]] && printf 'background-image = "%s"\n' "$1"
    if [[ -n "$1" ]] && is_narrow "$1"; then echo 'background-image-fit = contain'; fi
    [[ -n "$2" ]] && printf 'background-image-opacity = %s\n' "$2"
    [[ -n "${3:-}" ]] && printf '# hidden-image = "%s"\n' "$3"
    # An effect whose file is gone (retired in an update) is dropped quietly.
    [[ -n "$fx" && -f "$fx" ]] && printf 'custom-shader = "%s"\n' "$fx"
    [[ -n "$theme" ]] && printf 'theme = %s\n' "$theme"
    true
  } > "$BG_CONF"
}

# ---------- effects (animated shaders) ----------

# Effects are GLSL shaders that Ghostty runs on the GPU. They only add light on
# top of the picture (snow, leaves...), so the text stays sharp. They are installed
# next to the commands, in ~/.local/share/ghostty-bg/fx; drop your own .glsl there.
FX_DIR="${GHOSTTY_BG_SHARE:-$HOME/.local/share/ghostty-bg}/fx"

# The effect shader ghostty-bg has switched on (path), or empty.
managed_fx() {
  [[ -f "$BG_CONF" ]] || return 0
  # Skip the viewing mode's own motion shader (see managed_opacity).
  sed -n 's/^custom-shader = "\(.*\)"$/\1/p' "$BG_CONF" | grep -v '/motion/' | head -1 || true
}

fx_name() { basename "${1%.glsl}"; }

# Each shader starts with comment lines such as "// zh: 雪" and "// group: weather".
fx_meta() { sed -n "s|^// $2: *||p" "$1" | head -1; }
# Short description: the Chinese name, or the text after the dash on line 1.
fx_label() {
  if [[ "$UI_LANG" == zh ]]; then
    fx_meta "$1" zh
  else
    sed -n '1s|^// [a-z0-9]* — ||p' "$1"
  fi
}

list_fx() {
  [[ -d "$FX_DIR" ]] || return 0
  find "$FX_DIR" -maxdepth 1 -type f -name '*.glsl' | sort
}

# Categories in display order; a shader with an unknown group goes under "other".
FX_GROUPS="weather nature animals ocean festival space geek fantasy other"

group_title() {
  case "$1" in
    weather)  msg 'Weather'  '天气' ;;
    nature)   msg 'Nature'   '自然' ;;
    animals)  msg 'Animals'  '动物' ;;
    ocean)    msg 'Ocean'    '海洋' ;;
    festival) msg 'Festival' '节日' ;;
    space)    msg 'Space'    '太空' ;;
    geek)     msg 'Geek'     '极客' ;;
    fantasy)  msg 'Fantasy'  '奇幻' ;;
    *)        msg 'Other'    '其他' ;;
  esac
}

# Accept a category in English or Chinese; prints the English key, or nothing.
group_key() {
  case "$1" in
    weather|天气)  echo weather ;;
    nature|自然)   echo nature ;;
    animals|动物)  echo animals ;;
    ocean|海洋)    echo ocean ;;
    festival|节日) echo festival ;;
    space|太空)    echo space ;;
    geek|极客)     echo geek ;;
    fantasy|奇幻)  echo fantasy ;;
    other|其他)    echo other ;;
  esac
}

# One line per effect, in category order then by name:
#   group <TAB> name <TAB> label <TAB> path
# Read in a single awk pass: with dozens of shaders, one process per file is slow.
fx_index() {
  local files
  files="$(list_fx)"
  [[ -n "$files" ]] || return 0
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 awk -v lang="$UI_LANG" -v order="$FX_GROUPS" '
    function emit(   o, label) {
      o = rank[g]; if (o == "") { g = "other"; o = rank["other"] }
      label = (lang == "zh" && zh != "") ? zh : en
      printf "%02d\t%s\t%s\t%s\t%s\n", o, g, name, label, path
    }
    BEGIN { n = split(order, gs, " "); for (i = 1; i <= n; i++) rank[gs[i]] = i }
    FNR == 1 {
      if (path != "") emit()
      path = FILENAME; name = FILENAME; sub(/^.*\//, "", name); sub(/\.glsl$/, "", name)
      g = "other"; zh = ""; en = $0; sub(/^\/\/ [a-z0-9]+ — /, "", en)
    }
    FNR <= 6 && /^\/\/ zh:/    { zh = $0; sub(/^\/\/ zh: */, "", zh) }
    FNR <= 6 && /^\/\/ group:/ { g = $0;  sub(/^\/\/ group: */, "", g) }
    END { if (path != "") emit() }
  ' | sort -t "$(printf '\t')" -k1,1n -k3,3 | cut -f2-
}

# bgf (in a terminal): browse the effects with the keyboard. The terminal itself
# is the preview — every key press switches the effect at once. ← → move within a
# category, ↑ ↓ jump between categories, 1-9 pick one, r random, 0 none.
# Enter keeps what is on screen; Esc / q puts back what was on before.
fx_browse() {
  local index="$1" cur="$2" g name label path i n key rest
  # Globals, not locals: the exit trap may run after this function has returned.
  FXB_N=(); FXB_L=(); FXB_P=(); FXB_GI=(); FXB_FIRST=(); FXB_COUNT=(); FXB_TITLE=()
  local last_g=""
  n=0
  while IFS=$'\t' read -r g name label path; do
    if [[ "$g" != "$last_g" ]]; then
      FXB_FIRST+=("$n"); FXB_COUNT+=(0); FXB_TITLE+=("$(group_title "$g")"); last_g="$g"
    fi
    i=$(( ${#FXB_FIRST[@]} - 1 ))
    FXB_COUNT[i]=$(( FXB_COUNT[i] + 1 ))
    FXB_N+=("$name"); FXB_L+=("$label"); FXB_P+=("$path"); FXB_GI+=("$i")
    n=$(( n + 1 ))
  done <<< "$index"

  # Start on the effect that is on now, else on the first one.
  FXB_G=0; FXB_POS=0; FXB_OFF=0; FXB_PANEL=1
  for (( i = 0; i < n; i++ )); do
    if [[ "${FXB_P[i]}" == "$cur" ]]; then
      FXB_G="${FXB_GI[i]}"; FXB_POS=$(( i - FXB_FIRST[FXB_GI[i]] ))
    fi
  done

  # Keep an exact copy of the managed file: Esc, Ctrl+C or a closed tab put it back.
  FXB_SAVED="$(mktemp)"
  FXB_KEEP=0
  cp "$BG_CONF" "$FXB_SAVED"
  leave_browse() {
    trap - INT TERM HUP EXIT
    (( FXB_KEEP )) || cp "$FXB_SAVED" "$BG_CONF"
    rm -f "$FXB_SAVED"
    reload_ghostty
    printf '\033[?25h\033[?1049l'        # show the cursor, leave the alternate screen
  }
  trap 'leave_browse; exit 0' INT TERM HUP
  trap 'leave_browse' EXIT

  fxb_index() { echo $(( FXB_FIRST[FXB_G] + FXB_POS )); }
  fxb_apply() {
    if (( FXB_OFF )); then FX_NEXT=""; else FX_NEXT="${FXB_P[$(fxb_index)]}"; fi
    write_include "$(current_image)" "$(managed_opacity)" "$(hidden_image)"
    reload_ghostty
  }
  # A card in the middle of the top of the screen: category tabs, the effects of
  # this category in a 3-column grid, the one that is on, and the keys. Every
  # piece is placed with cursor positioning, so wide Chinese text needs no width maths.
  fxb_draw() {
    local cols W X Y cw rows H k j r c sel x line hint
    printf '\033[0m\033[H\033[J'
    (( FXB_PANEL )) || return 0
    local card=$'\033[0;48;5;236;38;5;252m' dim=$'\033[0;48;5;236;38;5;244m'
    local edge=$'\033[0;48;5;236;38;5;240m' hi=$'\033[0;1;48;5;73;38;5;234m'
    local bold=$'\033[0;1;48;5;236;38;5;255m' acc=$'\033[0;48;5;236;38;5;80m'
    # stty reads the real window size; tput inside $(...) sees a pipe and says 80.
    cols="$({ stty size </dev/tty | cut -d' ' -f2; } 2>/dev/null || true)"
    [[ "$cols" =~ ^[0-9]+$ ]] && (( cols >= 20 )) || cols=80
    W=88; (( W <= cols - 2 )) || W=$(( cols - 2 ))
    (( W >= 40 )) || W=40
    X=$(( (cols - W) / 2 + 1 )); Y=2
    cw=$(( (W - 4) / 3 ))
    rows=$(( (FXB_COUNT[FXB_G] + 2) / 3 ))
    H=$(( rows + 8 ))
    at() { printf '\033[%d;%dH' "$(( Y + $1 ))" "$(( X + $2 ))"; }

    # The empty card: borders and background, one row at a time.
    line="$(printf '%*s' $(( W - 2 )) '' | sed 's/ /─/g')"
    at 0 0; printf '%s╭%s╮' "$edge" "$line"
    for (( r = 1; r < H - 1; r++ )); do
      at "$r" 0; printf '%s│%s%*s%s│' "$edge" "$card" $(( W - 2 )) '' "$edge"
    done
    at $(( H - 3 )) 0; printf '%s├%s┤' "$edge" "$line"
    at $(( H - 1 )) 0; printf '%s╰%s╯' "$edge" "$line"
    at 0 3; printf '%s %s ' "$acc" "$(msg 'ghostty-bg effects' 'ghostty-bg 特效')"

    # Row 1: category tabs.
    at 1 2
    for (( k = 0; k < ${#FXB_TITLE[@]}; k++ )); do
      if (( k == FXB_G )); then printf '%s %s %s ' "$hi" "${FXB_TITLE[k]}" "$card"
      else printf '%s %s  ' "$dim" "${FXB_TITLE[k]}"; fi
    done

    # Rows 3..: the effects in this category, numbered for the 1-9 keys.
    sel="$(fxb_index)"
    for (( k = 0; k < FXB_COUNT[FXB_G]; k++ )); do
      j=$(( FXB_FIRST[FXB_G] + k ))
      r=$(( 3 + k / 3 )); c=$(( k % 3 ))
      at "$r" $(( 2 + c * cw ))
      if (( k < 9 )); then x="$(( k + 1 ))"; else x=" "; fi
      if (( j == sel && ! FXB_OFF )); then
        printf '%s %s %s' "$hi" "$x" "${FXB_N[j]}"
        [[ "$UI_LANG" == zh ]] && printf ' %s' "${FXB_L[j]}"
        printf ' '
      else
        printf '%s %s %s%s' "$dim" "$x" "$card" "${FXB_N[j]}"
        [[ "$UI_LANG" == zh ]] && printf ' %s%s' "$dim" "${FXB_L[j]}"
      fi
    done

    # What is on now.
    at $(( H - 4 )) 3
    if (( FXB_OFF )); then
      printf '%s%s' "$bold" "$(msg 'No effect' '无特效')"
    else
      printf '%s%s  ' "$bold" "${FXB_N[sel]}"
      line="${FXB_L[sel]}"
      (( ${#line} <= W - 30 )) || line="${line:0:$(( W - 33 ))}..."
      printf '%s%s  %s%s %d/%d' "$card" "$line" "$dim" "${FXB_TITLE[FXB_G]}" \
             $(( FXB_POS + 1 )) "${FXB_COUNT[FXB_G]}"
    fi

    # The keys.
    hint="$(msg '←→ effect  ↑↓ category  1-9 pick  r random  0 none  space hide  ⏎ keep  esc undo' \
                '←→ 换一个  ↑↓ 换一类  1-9 选  r 随机  0 关掉  空格 隐藏  回车 保留  esc 取消')"
    at $(( H - 2 )) 3; printf '%s%s' "$dim" "$hint"
    printf '\033[0m'
  }

  printf '\033[?1049h\033[?25l'   # alternate screen, hide the cursor
  fxb_apply
  fxb_draw

  while IFS= read -r -s -n 1 key </dev/tty; do
    if [[ "$key" == $'\033' ]]; then
      # Arrow keys arrive as ESC [ A..D; a lone Esc has nothing after it.
      rest=""
      IFS= read -r -s -n 2 -t 1 rest </dev/tty || true
      case "$rest" in
        '[C') key=l ;; '[D') key=h ;; '[A') key=k ;; '[B') key=j ;;
        *)    break ;;
      esac
    fi
    case "$key" in
      '')    FXB_KEEP=1; break ;;                       # Enter
      q|Q)   break ;;
      ' ')   FXB_PANEL=$(( 1 - FXB_PANEL )); fxb_draw; continue ;;
      l|L)   FXB_POS=$(( (FXB_POS + 1) % FXB_COUNT[FXB_G] )) ;;
      h|H)   FXB_POS=$(( (FXB_POS - 1 + FXB_COUNT[FXB_G]) % FXB_COUNT[FXB_G] )) ;;
      j|J|k|K)
             if [[ "$key" == [jJ] ]]; then FXB_G=$(( (FXB_G + 1) % ${#FXB_FIRST[@]} ))
             else FXB_G=$(( (FXB_G - 1 + ${#FXB_FIRST[@]}) % ${#FXB_FIRST[@]} )); fi
             (( FXB_POS < FXB_COUNT[FXB_G] )) || FXB_POS=$(( FXB_COUNT[FXB_G] - 1 )) ;;
      [1-9]) (( key <= FXB_COUNT[FXB_G] )) || continue
             FXB_POS=$(( key - 1 )) ;;
      r|R)   i=$(( RANDOM % n ))
             if (( n > 1 && i == $(fxb_index) )); then i=$(( (i + 1) % n )); fi
             FXB_G="${FXB_GI[i]}"; FXB_POS=$(( i - FXB_FIRST[FXB_GI[i]] )) ;;
      0)     FXB_OFF=1; fxb_apply; fxb_draw; continue ;;
      *)     continue ;;
    esac
    FXB_OFF=0
    fxb_apply
    fxb_draw
  done
  leave_browse

  if (( ! FXB_KEEP )); then
    msg "Effect unchanged." "特效没有改动。"
  elif (( FXB_OFF )); then
    msg "Effect is off." "特效已关闭。"
  else
    i="$(fxb_index)"
    msg "Effect: ${FXB_N[i]} — ${FXB_L[i]}  (bgf off stops it)" "特效：${FXB_N[i]} ${FXB_L[i]}（bgf off 关掉）"
  fi
}

# bgf / bgs fx            in a terminal: browse with the keyboard (fx_browse)
# bgf list                the effects, one line per category
# bgf <category>          one category in detail (English or Chinese name)
# bgf <name>              switch an effect on (replaces the previous one)
# bgf next | prev         step through all effects, category by category
# bgf random              a random effect
# bgf off                 switch the effect off
cmd_fx() {
  require_init
  local want="${1:-}" cur f found="" index key
  cur="$(managed_fx)"
  index="$(fx_index)"
  [[ -n "$index" || "$want" == off || "$want" == none ]] ||
    die "no effects are installed in $FX_DIR — run the installer again." \
        "$FX_DIR 里没有特效——请重新运行一次安装命令。"

  if [[ -z "$want" && -t 0 && -t 1 ]]; then
    fx_browse "$index" "$cur"
    return
  fi

  if [[ -z "$want" || "$want" == list ]]; then
    # Compact: a title per category, then its effects wrapped to the window.
    local width
    width="$(tput cols 2>/dev/null || echo 80)"
    printf '%s\n' "$index" | awk -F '\t' -v lang="$UI_LANG" -v cur="$cur" -v width="$width" \
                                 -v titles="$(for g in $FX_GROUPS; do printf '%s=%s;' "$g" "$(group_title "$g")"; done)" '
      BEGIN { n = split(titles, t, ";"); for (i = 1; i <= n; i++) { split(t[i], kv, "="); title[kv[1]] = kv[2] } }
      {
        if ($1 != group) {
          if (group != "") printf "\n"
          group = $1; printf "%s\n", title[group]; col = 0
        }
        item = (lang == "zh" ? $2 " " $3 : $2)
        if ($4 == cur) item = "*" item
        w = length($2) + 1 + (lang == "zh" ? (length($3) / 3) * 2 : 0) + ($4 == cur)
        if (lang != "zh") w = length(item)
        if (col == 0) { printf "  %s", item; col = 2 + w }
        else if (col + 3 + w > width) { printf "\n  %s", item; col = 2 + w }
        else { printf " · %s", item; col += 3 + w }
      }
      END { if (group != "") printf "\n" }'
    echo
    if [[ -n "$cur" ]]; then
      msg "On: $(fx_name "$cur").  bgf alone to browse with the arrow keys · bgf <name> · bgf random · bgf off" \
          "当前特效：$(fx_name "$cur")。用方向键挑：直接敲 bgf；换：bgf <名字> / bgf random；关掉：bgf off"
    else
      msg "No effect is on.  bgf alone to browse with the arrow keys · bgf <name> · bgf random" \
          "现在没有开特效。用方向键挑：直接敲 bgf；开启：bgf <名字>；随机：bgf random"
    fi
    return
  fi

  # One category in detail.
  key="$(group_key "$want")"
  if [[ -n "$key" ]]; then
    local lines
    lines="$(printf '%s\n' "$index" | awk -F '\t' -v g="$key" '$1 == g')"
    [[ -n "$lines" ]] || die "no effects in that category." "这一类里没有特效。"
    group_title "$key"
    printf '%s\n' "$lines" | while IFS=$'\t' read -r _ name label path; do
      if [[ "$path" == "$cur" ]]; then printf '* %-13s %s\n' "$name" "$label"
      else printf '  %-13s %s\n' "$name" "$label"; fi
    done
    return
  fi

  # next / prev: walk the list in category order, wrapping around.
  if [[ "$want" == next || "$want" == prev ]]; then
    local first="" last="" prevf="" pick="" take=0
    while IFS=$'\t' read -r _ _ _ f; do
      [[ -n "$first" ]] || first="$f"
      if (( take )); then pick="$f"; take=0; fi
      if [[ "$f" == "$cur" ]]; then
        if [[ "$want" == next ]]; then take=1; else pick="$prevf"; fi
      fi
      prevf="$f"; last="$f"
    done <<< "$index"
    if [[ -z "$pick" ]]; then
      if [[ "$want" == next ]]; then pick="$first"; else pick="$last"; fi
    fi
    want="$(fx_name "$pick")"
  fi

  if [[ "$want" == random ]]; then
    local count pickn
    count="$(printf '%s\n' "$index" | grep -c .)"
    pickn=$(( RANDOM % count + 1 ))
    f="$(printf '%s\n' "$index" | sed -n "${pickn}p" | cut -f4)"
    if [[ "$f" == "$cur" && count -gt 1 ]]; then
      f="$(printf '%s\n' "$index" | sed -n "$(( pickn % count + 1 ))p" | cut -f4)"
    fi
    want="$(fx_name "$f")"
  fi

  if [[ "$want" == off || "$want" == none ]]; then
    FX_NEXT=""
    write_include "$(current_image)" "$(managed_opacity)" "$(hidden_image)"
    reload_ghostty
    msg "Effect is off." "特效已关闭。"
    return
  fi

  found="$(printf '%s\n' "$index" | awk -F '\t' -v n="$want" '$2 == n { print $4; exit }')"
  [[ -n "$found" ]] ||
    die "no effect named \"$want\" — see: bgf list" "没有叫 \"$want\" 的特效——用 bgf list 看有哪些"

  FX_NEXT="$found"
  write_include "$(current_image)" "$(managed_opacity)" "$(hidden_image)"
  reload_ghostty
  local label
  label="$(fx_label "$found")"
  msg "Effect: $want — $label  (animates in the focused window; bgf off stops it)" \
      "特效：${want} ${label}（在当前聚焦的窗口里动；bgf off 关掉）"
}

# ---------- themes (colour schemes) ----------

# Ghostty ships hundreds of colour themes. bgt writes a `theme = ...` line into
# the managed file, which is loaded after the main config and so overrides its
# theme. Only the theme of the current macOS appearance (light or dark) is
# changed; a `light:A,dark:B` pair keeps its other half.

ghostty_bin() {
  if command -v ghostty >/dev/null 2>&1; then command -v ghostty
  elif [[ -x /Applications/Ghostty.app/Contents/MacOS/ghostty ]]; then echo /Applications/Ghostty.app/Contents/MacOS/ghostty
  fi
}

# "dark" or "light": the macOS appearance right now.
appearance() {
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" == Dark ]]; then echo dark; else echo light; fi
}

# The theme line ghostty-bg wrote, or empty.
managed_theme() {
  [[ -f "$BG_CONF" ]] || return 0
  sed -n 's/^theme = //p' "$BG_CONF" | head -1
}

# The theme in effect: ours if set, else what Ghostty reads from the main config.
effective_theme() {
  local t bin
  t="$(managed_theme)"
  if [[ -z "$t" ]]; then
    bin="$(ghostty_bin)"
    [[ -n "$bin" ]] && t="$("$bin" +show-config 2>/dev/null | sed -n 's/^theme = //p' | head -1 || true)"
  fi
  echo "$t"
}

# $1 theme value, $2 light|dark: the theme used for that appearance.
theme_part() {
  local v="$1" part
  if [[ "$v" == *light:* || "$v" == *dark:* ]]; then
    part="$(printf '%s\n' "$v" | tr ',' '\n' | sed -n "s/^ *$2: *//p" | head -1)"
    echo "$part"
  else
    echo "$v"
  fi
}

# $1 theme value, $2 light|dark, $3 new theme name: the value with that half replaced.
theme_with() {
  local v="$1" slot="$2" name="$3" light dark
  if [[ "$v" == *light:* || "$v" == *dark:* ]]; then
    light="$(theme_part "$v" light)"; dark="$(theme_part "$v" dark)"
    if [[ "$slot" == light ]]; then light="$name"; else dark="$name"; fi
    echo "light:${light:-$name},dark:${dark:-$name}"
  else
    echo "$name"
  fi
}

# Theme names, one per line. $1: dark | light | all.
list_themes() {
  local bin
  bin="$(ghostty_bin)"
  [[ -n "$bin" ]] || die "cannot find the ghostty command." "找不到 ghostty 命令。"
  "$bin" +list-themes --plain --color="$1" 2>/dev/null | sed 's/ ([a-z]*)$//'
}

# ---------- per-tab colours (bgt here) ----------

# `bgt here` recolours only the current tab: the theme's colours are sent to
# the terminal as escape sequences (OSC 4 palette, OSC 10/11/12 foreground,
# background, cursor). Nothing is written to the config and Ghostty is not
# reloaded, so other tabs keep the global theme. The colours last until the
# tab closes or `bgt here reset`.

# The file of a theme, by name.
theme_file() {
  local bin
  bin="$(ghostty_bin)"
  [[ -n "$bin" ]] || return 0
  "$bin" +list-themes --plain --path 2>/dev/null |
    awk -v n="$1" '!done && index($0, n " (") == 1 { sub(/^.* \([a-z]+\) /, ""); print; done = 1 }'   # no early exit: SIGPIPE + pipefail
}

# Send a theme's colours to this tab.
theme_here_apply() {
  local f
  f="$(theme_file "$1")"
  [[ -n "$f" && -f "$f" ]] || return 0
  awk '
    function osc(s) { printf "\033]%s\007", s }
    { gsub(/[ \t]/, "") }
    /^palette=[0-9]+=#/ { split(substr($0, 9), kv, "="); osc("4;" kv[1] ";" kv[2]) }
    /^foreground=#/   { osc("10;" substr($0, 12)) }
    /^background=#/   { osc("11;" substr($0, 12)) }
    /^cursor-color=#/ { osc("12;" substr($0, 14)) }
  ' "$f" 2>/dev/null >/dev/tty || true
}

# Back to the global theme in this tab.
theme_here_reset() {
  printf '\033]104\007\033]110\007\033]111\007\033]112\007' 2>/dev/null >/dev/tty || true
}

# Switch the theme for the current appearance (no checks; used while browsing).
# The base value comes from THEME_BASE when set (the value before browsing began).
theme_apply() {
  local base slot
  if [[ -n "${THEME_HERE:-}" ]]; then theme_here_apply "$1"; return; fi
  base="${THEME_BASE-$(effective_theme)}"
  slot="${THEME_SLOT:-$(appearance)}"
  THEME_NEXT="$(theme_with "$base" "$slot" "$1")"
  write_include "$(current_image)" "$(managed_opacity)" "$(hidden_image)"
  reload_ghostty >/dev/null
}

# A small colour sample: the 16 terminal colours and some typical output.
theme_sample() {
  local i
  printf '\n  '
  for i in 0 1 2 3 4 5 6 7; do printf '\033[4%dm    \033[0m' "$i"; done
  printf '\n  '
  for i in 0 1 2 3 4 5 6 7; do printf '\033[10%dm    \033[0m' "$i"; done
  printf '\n\n'
  printf '  \033[35m❯\033[0m \033[1mgit status\033[0m\n'
  printf '  On branch \033[36mmain\033[0m\n'
  printf '  \033[32m  modified:   README.md\033[0m\n'
  printf '  \033[31m  deleted:    old.txt\033[0m\n\n'
  printf '  \033[35m❯\033[0m \033[1mls\033[0m\n'
  printf '  \033[1;34mfx\033[0m  \033[1;34msamples\033[0m  \033[32mghostty-bg\033[0m  README.md\n\n'
  printf '  \033[33mwarning:\033[0m \033[2mnothing to commit\033[0m\n'
  printf '  \033[90m# comment\033[0m  \033[95mfn\033[0m \033[94mmain\033[0m() { \033[92m"hello"\033[0m }\n'
}

# What bgt is changing, for headers and messages: this tab, or the light / dark theme.
theme_scope() {
  if [[ -n "${THEME_HERE:-}" ]]; then msg "this tab" "这个 Tab"
  elif [[ "$THEME_SLOT" == dark ]]; then msg "dark appearance" "深色外观"
  else msg "light appearance" "浅色外观"; fi
}

# Browse with fzf: type to search, the terminal recolours as the cursor moves.
theme_browse_fzf() {
  local list="$1" start="$2" self pick rc
  self="$0"; [[ "$self" == */* ]] || self="$(command -v "$self")"
  export THEME_BASE THEME_SLOT THEME_HERE
  pick="$(printf '%s\n' "$list" | fzf --height=70% --layout=reverse --border=rounded \
      --prompt="$(msg 'theme> ' '主题> ')" \
      --header="$(msg "Changing: $(theme_scope) · type to search · Enter keeps · Esc undoes" \
                      "改的是：$(theme_scope) · 打字搜索 · 回车保留 · Esc 恢复")" \
      --bind "start:unbind(focus)" --bind "load:pos($start)+rebind(focus)" --bind "change:first" \
      --bind "focus:execute-silent('$self' _theme-apply {})" \
      --preview "'$self' _theme-sample" --preview-window=right,50%,border-left)" && rc=0 || rc=$?
  (( rc == 0 )) && [[ -n "$pick" ]] || return 1
  echo "$pick"
}

# Browse without fzf: a list with the cursor in the middle and a colour sample.
theme_browse_keys() {
  local -a names=()
  local n i sel="$2" key rest top rows=13 cols x
  while IFS= read -r i; do names+=("$i"); done <<< "$1"
  n=${#names[@]}
  TB_PICK=""

  draw() {
    local k j
    printf '\033[0m\033[H\033[J'
    printf '\n  \033[1m%s\033[0m  \033[2m%d/%d\033[0m\n\n' \
      "$(msg "Theme ($(theme_scope))" "主题（$(theme_scope)）")" $(( sel + 1 )) "$n"
    top=$(( sel - rows / 2 )); (( top >= 0 )) || top=0
    (( top + rows <= n )) || top=$(( n - rows )); (( top >= 0 )) || top=0
    for (( k = 0; k < rows && top + k < n; k++ )); do
      j=$(( top + k ))
      if (( j == sel )); then printf '  \033[7m %s \033[0m\n' "${names[j]}"
      else printf '   %s\n' "${names[j]}"; fi
    done
    # The sample on the right of the list.
    cols="$({ stty size </dev/tty | cut -d' ' -f2; } 2>/dev/null || true)"
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
    x=$(( cols > 100 ? 40 : 0 ))
    if (( x > 0 )); then
      theme_sample | { r=3; while IFS= read -r line; do printf '\033[%d;%dH%s' "$r" "$x" "$line"; r=$(( r + 1 )); done; }
    fi
    printf '\033[%d;1H\n  \033[2m%s\033[0m' $(( rows + 5 )) \
      "$(msg '↑↓ move · ←→ jump 10 · r random · Enter keep · Esc undo' '↑↓ 换一个 · ←→ 跳 10 个 · r 随机 · 回车 保留 · Esc 恢复')"
  }

  printf '\033[?1049h\033[?25l'
  theme_apply "${names[sel]}"; draw
  while IFS= read -r -s -n 1 key </dev/tty; do
    if [[ "$key" == $'\033' ]]; then
      rest=""
      IFS= read -r -s -n 2 -t 1 rest </dev/tty || true
      case "$rest" in
        '[A') key=up ;; '[B') key=down ;; '[C') key=right ;; '[D') key=left ;;
        *)    break ;;
      esac
    fi
    case "$key" in
      '')       TB_PICK="${names[sel]}"; break ;;
      q|Q)      break ;;
      up|k)     sel=$(( (sel - 1 + n) % n )) ;;
      down|j)   sel=$(( (sel + 1) % n )) ;;
      left)     sel=$(( sel - 10 )); (( sel >= 0 )) || sel=0 ;;
      right)    sel=$(( sel + 10 )); (( sel < n )) || sel=$(( n - 1 )) ;;
      r|R)      sel=$(( RANDOM % n )) ;;
      *)        continue ;;
    esac
    theme_apply "${names[sel]}"; draw
  done
  printf '\033[?25h\033[?1049l'
  [[ -n "$TB_PICK" ]]
}

# bgt / bgs theme            browse the themes for the current appearance (fzf if installed)
# bgt all                    browse every theme, light and dark
# bgt <name>                 use that theme for the current appearance
# bgt random                 a random one
# bgt list                   list them (* = in use)
# bgt reset                  back to the theme in your own Ghostty config
# bgt here [...]             the same, but only for this tab (no config change, no reload)
cmd_theme() {
  require_init
  THEME_HERE=""
  if [[ "${1:-}" == here ]]; then
    THEME_HERE=1; shift
    { : >/dev/tty; } 2>/dev/null ||
      die "bgt here changes the colours of a terminal tab — run it in one." "bgt here 改的是终端 Tab 的颜色——请在终端里运行。"
  fi
  local want="${1:-}" slot list cur start pick rc=0
  slot="$(appearance)"
  THEME_SLOT="$slot"
  THEME_BASE="$(effective_theme)"
  cur="$(theme_part "$THEME_BASE" "$slot")"

  if [[ -n "$THEME_HERE" && ( "$want" == reset || "$want" == off || "$want" == default ) ]]; then
    theme_here_reset
    msg "This tab: back to the global theme." "这个 Tab：恢复成全局主题。"
    return
  fi

  case "$want" in
    reset|off|default)
      THEME_NEXT=""
      write_include "$(current_image)" "$(managed_opacity)" "$(hidden_image)"
      reload_ghostty
      msg "Theme: back to the one in your Ghostty config." "主题：恢复成你 Ghostty 配置里的那个。"
      return ;;
    list)
      list_themes "$slot" | while IFS= read -r t; do
        if [[ "$t" == "$cur" ]]; then echo "* $t"; else echo "  $t"; fi
      done
      return ;;
  esac

  if [[ "$want" == all ]]; then list="$(list_themes all)"; else list="$(list_themes "$slot")"; fi
  [[ -n "$list" ]] || die "Ghostty listed no themes." "Ghostty 没有列出任何主题。"

  if [[ "$want" == random ]]; then
    want="$(printf '%s\n' "$list" | awk -v n="$RANDOM" '{ a[NR] = $0 } END { print a[n % NR + 1] }')"
  fi

  if [[ -n "$want" && "$want" != all ]]; then
    # A name: exact first, then ignoring case.
    pick="$(list_themes all | awk -v w="$want" '!f && $0 == w { print; f = 1 }')"
    [[ -n "$pick" ]] || pick="$(list_themes all | awk -v w="$want" '!f && tolower($0) == tolower(w) { print; f = 1 }')"
    [[ -n "$pick" ]] || die "no theme named \"$want\" — see: bgt list" "没有叫 \"$want\" 的主题——用 bgt list 看有哪些"
    theme_apply "$pick"
    msg "Theme ($(theme_scope)): $pick" "主题（$(theme_scope)）：$pick"
    return
  fi

  # Browsing needs a terminal.
  [[ -t 0 && -t 1 ]] || { THEME_HERE=""; cmd_theme list; return; }
  start="$(printf '%s\n' "$list" | awk -v c="$cur" '!f && $0 == c { print NR; f = 1 }')"
  [[ -n "$start" ]] || start=1

  # Keep an exact copy of the managed file: Esc, Ctrl+C or a closed tab put it back.
  TB_SAVED="$(mktemp)"; TB_KEEP=0
  cp "$BG_CONF" "$TB_SAVED"
  leave_theme() {
    trap - INT TERM HUP EXIT
    if [[ -n "$THEME_HERE" ]]; then
      (( TB_KEEP )) || theme_here_reset        # this tab only: nothing to reload
    else
      (( TB_KEEP )) || cp "$TB_SAVED" "$BG_CONF"
      reload_ghostty
    fi
    rm -f "$TB_SAVED"
    printf '\033[?25h'
  }
  trap 'leave_theme; exit 0' INT TERM HUP
  trap 'leave_theme' EXIT

  if command -v fzf >/dev/null 2>&1; then
    pick="$(theme_browse_fzf "$list" "$start")" || rc=$?
  else
    theme_browse_keys "$list" $(( start - 1 )) || rc=$?
    pick="$TB_PICK"
  fi
  if (( rc == 0 )) && [[ -n "$pick" ]]; then
    theme_apply "$pick"; TB_KEEP=1
  fi
  leave_theme
  if (( TB_KEEP )); then
    msg "Theme ($(theme_scope)): $pick" "主题（$(theme_scope)）：$pick"
  elif [[ -n "$THEME_HERE" ]]; then
    msg "This tab: back to the global theme." "这个 Tab：恢复成全局主题。"
  else
    msg "Theme unchanged." "主题没有改动。"
  fi
}

set_image() {
  local img="$1" name
  [[ -f "$img" ]] || die "image not found: $img" "找不到图片：$img"
  write_include "$img" "$(managed_opacity)"
  reload_ghostty
  name="$(basename "$img")"
  msg "Background: $name" "背景已换成：$name"
}

empty_library() {
  die "the library is empty — add one with: bgs add <image>" \
      "图库是空的——先加一张：bgs add <图片>"
}

# ---------- commands ----------

cmd_init() {
  mkdir -p "$CONFIG_DIR" "$LIB_DIR"
  [[ -f "$BG_CONF" ]] || write_include "" ""

  if is_initialized; then
    msg "Already set up: $CONFIG_FILE" "已经设置过：$CONFIG_FILE"
  else
    if [[ -f "$CONFIG_FILE" ]]; then
      local backup
      backup="$CONFIG_FILE.bak.$(date +%Y%m%d_%H%M%S)"
      cp -p "$CONFIG_FILE" "$backup"
      msg "Backed up your config to: $backup" "已备份你的配置：$backup"
    fi
    {
      echo ""
      echo "# --- ghostty-bg (https://github.com/aicoder2048/ghostty-bg) ---"
      echo "$INCLUDE_LINE"
      grep -qE '^[[:space:]]*background-image-opacity[[:space:]]*=' "$CONFIG_FILE" 2>/dev/null ||
        echo "background-image-opacity = 0.2"
      grep -qE '^[[:space:]]*background-image-fit[[:space:]]*=' "$CONFIG_FILE" 2>/dev/null ||
        echo "background-image-fit = cover"
    } >> "$CONFIG_FILE"
    msg "Added ghostty-bg settings to: $CONFIG_FILE" "已在配置里加上 ghostty-bg 的设置：$CONFIG_FILE"
  fi

  msg "Image folder: $LIB_DIR" "图库目录：$LIB_DIR"
  command -v fzf >/dev/null ||
    msg "Tip: install fzf to pick images interactively (brew install fzf)." \
        "提示：装上 fzf 就能交互式挑图（brew install fzf）。"
  echo ""
  msg "Next: bgs add ~/Pictures/some-photo.jpg   (bgs = ghostty-bg)" "下一步：bgs add ~/Pictures/某张照片.jpg   （bgs 就是 ghostty-bg）"
}

is_image() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.png|*.jpg|*.jpeg) return 0 ;;
    *) return 1 ;;
  esac
}

# Print the library file whose content is identical to $1, if any.
find_duplicate() {
  local src="$1" size f
  size="$(stat -f %z "$src")"
  while IFS= read -r f; do
    if [[ "$(stat -f %z "$f")" == "$size" ]] && cmp -s "$src" "$f"; then
      echo "$f"
      return
    fi
  done < <(list_images)
}

# State shared by add_one / cmd_add (plain variables: bash 3.2 + set -u dislikes empty arrays).
ADD_FIRST=""     # first image newly copied into the library
ADD_COUNT=0      # images copied
SKIP_COUNT=0     # images skipped (already in the library, or not PNG/JPG)
DUP_FOUND=""     # library copy of the last already-present image

# ---------- widening narrow images (needs ImageMagick) ----------

# Narrow images are stored as a 16:10 version: the photo in the middle, the sides
# filled with a blurred, darkened, enlarged copy of itself. Only when ImageMagick
# 7 (`magick`) is installed and GHOSTTY_BG_BLUR is not 0; otherwise the photo is
# copied as is and simply shown whole (see write_include).
blur_enabled() {
  [[ "${GHOSTTY_BG_BLUR:-1}" != 0 ]] && command -v magick >/dev/null
}

# $1: source image, $2: destination .jpg
make_wide() {
  local src="$1" dest="$2" h w
  # Height after applying the EXIF rotation (phone photos), capped at 2160 px.
  h="$(magick "$src" -auto-orient -format '%h' info: 2>/dev/null)" || return 1
  [[ "$h" =~ ^[0-9]+$ ]] || return 1
  (( h > 2160 )) && h=2160
  w=$(( h * 16 / 10 ))
  # The blurred backdrop is made at 1/8 size and scaled back up: about 20x faster
  # than blurring at full size (0.5 s instead of 9 s for a phone photo), and it
  # looks the same, since the backdrop is meant to be soft anyway.
  local sw=$(( w / 8 )) sh=$(( h / 8 ))
  magick "$src" -auto-orient -resize "x$h" \
    \( +clone -resize "${sw}x${sh}^" -gravity center -extent "${sw}x${sh}" \
       -blur 0x5 -resize "${w}x${h}!" -modulate 70 \) \
    +swap -gravity center -composite -strip -quality 90 "$dest" 2>/dev/null
}

# The widened copy differs from the original, so content comparison cannot spot
# a re-added original. backgrounds/.sources maps "sha1<TAB>library file name".
SOURCES_INDEX_NAME=".sources"

source_sha() { shasum -a 1 "$1" | cut -d' ' -f1; }

# Print the library file made from a source with this sha1, if it still exists.
find_widened() {
  local sha="$1" index="$LIB_DIR/$SOURCES_INDEX_NAME" name
  [[ -f "$index" ]] || return 0
  while IFS=$'\t' read -r s name; do
    if [[ "$s" == "$sha" && -f "$LIB_DIR/$name" ]]; then echo "$LIB_DIR/$name"; return; fi
  done < "$index"
}

# Print a free library path for this file name (timestamp prefix if taken).
free_library_path() {
  local name="$1" dest n=1 stamp
  dest="$LIB_DIR/$name"
  # Same name but different content: keep both, the new one gets a timestamp prefix
  # (plus a counter if that name is taken too, e.g. several in the same second).
  if [[ -e "$dest" ]]; then
    stamp="$(date +%Y%m%d_%H%M%S)"
    dest="$LIB_DIR/$stamp-$name"
    while [[ -e "$dest" ]]; do
      n=$((n + 1))
      dest="$LIB_DIR/$stamp-$n-$name"
    done
  fi
  echo "$dest"
}

# Line prefix while adding: "[ 3/20] " when several images are added, else "  ".
ADD_PREFIX="  "

added() {   # $1: library path, $2 / $3: optional note in English / Chinese
  msg "${ADD_PREFIX}added: $(basename "$1")${2:+  ($2)}" "${ADD_PREFIX}已加入：$(basename "$1")${3:+（$3）}"
  [[ -n "$ADD_FIRST" ]] || ADD_FIRST="$1"
  ADD_COUNT=$((ADD_COUNT + 1))
}

add_one() {
  local src="$1" dup sha base dest
  dup="$(find_duplicate "$src")"
  if [[ -z "$dup" ]] && blur_enabled && is_narrow "$src"; then
    sha="$(source_sha "$src")"
    dup="$(find_widened "$sha")"
  fi
  if [[ -n "$dup" ]]; then
    msg "${ADD_PREFIX}already in library: $(basename "$dup")" "${ADD_PREFIX}图库里已有：$(basename "$dup")"
    DUP_FOUND="$dup"
    SKIP_COUNT=$((SKIP_COUNT + 1))
    return
  fi

  if blur_enabled && is_narrow "$src"; then
    base="$(basename "$src")"
    dest="$(free_library_path "${base%.*}-wide.jpg")"
    if make_wide "$src" "$dest"; then
      printf '%s\t%s\n' "${sha:-$(source_sha "$src")}" "$(basename "$dest")" >> "$LIB_DIR/$SOURCES_INDEX_NAME"
      added "$dest" "narrow image, widened with blurred sides" "竖图，已做成两边模糊的横版"
      return
    fi
    rm -f "$dest"
    msg "${ADD_PREFIX}(could not widen $base with ImageMagick; adding it as is)" \
        "${ADD_PREFIX}（ImageMagick 处理 $base 失败，按原图加入）"
  fi

  dest="$(free_library_path "$(basename "$src")")"
  cp "$src" "$dest"
  if is_narrow "$dest"; then
    added "$dest" "narrow image, shown whole" "竖图，会完整显示"
  else
    added "$dest"
  fi
}

# bgs add <image|folder> [more images or folders...]
# A folder adds every PNG/JPG directly inside it (not subfolders).
cmd_add() {
  require_init
  (( $# > 0 )) || die "usage: bgs add <image|folder> [...]" "用法：bgs add <图片|文件夹> [...]"
  mkdir -p "$LIB_DIR"
  local arg f found queue="" total=0 i=0

  # Pass 1: collect every image, so the total is known before the slow part starts.
  for arg in "$@"; do
    if [[ -d "$arg" ]]; then
      found=0
      while IFS= read -r f; do
        found=1
        queue="$queue$f"$'\n'
        total=$((total + 1))
      done < <(find "$arg" -maxdepth 1 -type f \
                 \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) | sort)
      (( found )) || msg "  no PNG/JPG in folder: $arg" "  文件夹里没有 PNG/JPG：$arg"
    elif [[ -f "$arg" ]]; then
      if is_image "$arg"; then
        queue="$queue$arg"$'\n'
        total=$((total + 1))
      else
        msg "  skipped (only PNG and JPG are supported): $arg" "  跳过（只支持 PNG 和 JPG）：$arg"
        SKIP_COUNT=$((SKIP_COUNT + 1))
      fi
    else
      msg "  not found: $arg" "  找不到：$arg"
      SKIP_COUNT=$((SKIP_COUNT + 1))
    fi
  done

  # Pass 2: add them, numbering the lines when there is more than one.
  local width=${#total}
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    i=$((i + 1))
    if (( total > 1 )); then ADD_PREFIX="$(printf '[%*d/%d] ' "$width" "$i" "$total")"; fi
    add_one "$f"
  done <<< "$queue"
  ADD_PREFIX="  "

  if (( ADD_COUNT + SKIP_COUNT > 1 )); then
    msg "Added $ADD_COUNT, skipped $SKIP_COUNT." "加入 $ADD_COUNT 张，跳过 $SKIP_COUNT 张。"
  fi
  if [[ -n "$ADD_FIRST" ]]; then
    set_image "$ADD_FIRST"
  elif [[ $# -eq 1 && -f "$1" && -n "$DUP_FOUND" ]]; then
    set_image "$DUP_FOUND"      # a single image that is already there: just switch to it
  elif [[ -n "$DUP_FOUND" ]]; then
    msg "Nothing new — those images are already in the library." "没有新图片——这些图都已经在图库里了。"
  else
    die "nothing was added." "没有加入任何图片。"
  fi
}

cmd_step() {
  require_init
  local direction="$1" images=() line cur idx=-1 i n
  while IFS= read -r line; do images+=("$line"); done < <(list_images)
  n=${#images[@]}
  (( n > 0 )) || empty_library
  cur="$(current_image)"
  for i in "${!images[@]}"; do
    if [[ "${images[$i]}" == "$cur" ]]; then idx=$i; fi
  done
  case "$direction" in
    next)   idx=$(( (idx + 1) % n )) ;;
    prev)   idx=$(( (idx - 1 + n) % n )) ;;
    random) idx=$(( RANDOM % n ))
            # Avoid picking the current image again when there is a choice.
            if (( n > 1 )) && [[ "${images[$idx]}" == "$cur" ]]; then idx=$(( (idx + 1) % n )); fi ;;
  esac
  set_image "${images[$idx]}"
}

# ---------- viewing mode ----------

# Motion shaders move every pixel, so they are only used when no text is on screen.
MOTION_DIR="${GHOSTTY_BG_SHARE:-$HOME/.local/share/ghostty-bg}/motion"

# Print the image before/after $2 in the library (wrapping), or a random other one.
neighbor_image() {
  local direction="$1" cur="$2" images=() line idx=0 i n
  while IFS= read -r line; do images+=("$line"); done < <(list_images)
  n=${#images[@]}
  for i in "${!images[@]}"; do
    if [[ "${images[$i]}" == "$cur" ]]; then idx=$i; fi
  done
  case "$direction" in
    next)   idx=$(( (idx + 1) % n )) ;;
    prev)   idx=$(( (idx - 1 + n) % n )) ;;
    random) i=$(( RANDOM % n ))
            if (( n > 1 && i == idx )); then i=$(( (i + 1) % n )); fi
            idx=$i ;;
  esac
  echo "${images[$idx]}"
}

# bgv / bgs view: nothing but the picture. The terminal switches to its blank
# alternate screen, the image goes to full opacity and a motion shader makes it
# drift like a slow camera move. n / p / r change the image; any other key ends
# it and everything is put back as it was.
cmd_view() {
  require_init
  [[ -t 0 && -t 1 ]] ||
    die "the viewing mode needs a terminal." "欣赏模式要在终端里运行。"
  local motion="$MOTION_DIR/kenburns.glsl"
  [[ -f "$motion" ]] ||
    die "the motion shader is missing ($motion) — run the installer again." \
        "缺少画面运动的特效文件（${motion}）——请重新运行一次安装命令。"

  # Globals, not locals: the exit trap may run after this function has returned.
  local img key rest
  img="$(current_image)"
  [[ -n "$img" && -f "$img" ]] || img="$(hidden_image)"
  [[ -n "$img" && -f "$img" ]] || img="$(list_images | head -1)"
  [[ -n "$img" ]] || empty_library
  VIEW_START="$img"
  VIEW_FX="$(managed_fx)"
  VIEW_OPACITY="$(managed_opacity)"
  VIEW_THEME="$(managed_theme)"

  # Keep an exact copy of the managed file and put it back when we leave,
  # however we leave (key press, Ctrl+C, closed tab).
  VIEW_SAVED="$(mktemp)"
  VIEW_IMG="$img"
  cp "$BG_CONF" "$VIEW_SAVED"
  leave_view() {
    trap - INT TERM HUP EXIT
    if [[ "$VIEW_IMG" == "$VIEW_START" ]]; then
      cp "$VIEW_SAVED" "$BG_CONF"                 # nothing changed: exact restore
    else
      FX_NEXT="$VIEW_FX"; THEME_NEXT="$VIEW_THEME"   # keep the image you stopped on
      write_include "$VIEW_IMG" "$VIEW_OPACITY"
    fi
    rm -f "$VIEW_SAVED"
    reload_ghostty
    printf '\033[?25h\033[?1049l'        # show the cursor, leave the alternate screen
  }
  trap 'leave_view; exit 0' INT TERM HUP
  trap 'leave_view' EXIT

  view_image() {
    {
      echo '# Managed by ghostty-bg — do not edit by hand. Run `bgs help` for commands.'
      echo '# view-mode'
      printf '# view-opacity = %s\n' "$VIEW_OPACITY"
      printf 'background-image = "%s"\n' "$1"
      if is_narrow "$1"; then echo 'background-image-fit = contain'; fi
      echo 'background-image-opacity = 1'
      printf 'custom-shader = "%s"\n' "$motion"
      [[ -n "$VIEW_FX" ]] && printf 'custom-shader = "%s"\n' "$VIEW_FX"
      [[ -n "$VIEW_THEME" ]] && printf 'theme = %s\n' "$VIEW_THEME"
      true
    } > "$BG_CONF"
    VIEW_IMG="$1"
    reload_ghostty
  }

  printf '\033[?1049h\033[2J\033[H\033[?25l'   # alternate screen, clear, hide the cursor
  view_image "$img"

  # A short hint, then a clean screen.
  printf '\033[2m  %s\033[0m' "$(msg 'n next · p previous · r random · any other key leaves' \
                                     'n 下一张 · p 上一张 · r 随机 · 其他任意键退出')"
  if IFS= read -r -s -n 1 -t 3 key </dev/tty; then :; else key="__none__"; fi
  printf '\r\033[K'

  while true; do
    if [[ "$key" == "__none__" ]]; then
      IFS= read -r -s -n 1 key </dev/tty || break
    fi
    if [[ "$key" == $'\033' ]]; then
      # Arrow keys arrive as ESC [ C etc.; a lone Esc has nothing after it.
      rest=""
      IFS= read -r -s -n 2 -t 1 rest </dev/tty || true
      case "$rest" in
        '[C'|'[B') key=n ;;
        '[D'|'[A') key=p ;;
        *)         break ;;
      esac
    fi
    case "$key" in
      n|N|' ') img="$(neighbor_image next "$img")" ;;
      p|P)     img="$(neighbor_image prev "$img")" ;;
      r|R)     img="$(neighbor_image random "$img")" ;;
      *)       break ;;
    esac
    view_image "$img"
    key="__none__"
  done
  leave_view
}

# Turn "5", "5s", "2m" or "1h" into whole seconds; prints nothing if it is not valid.
parse_interval() {
  local v="$1" n unit
  [[ "$v" =~ ^([0-9]+)([smh]?)$ ]] || return 0
  n="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
  case "$unit" in
    m) n=$((n * 60)) ;;
    h) n=$((n * 3600)) ;;
  esac
  (( n >= 1 )) && echo "$n"
}

# bga / bgs play [interval]: a slideshow that runs in the foreground of this
# terminal — a new random image every few seconds until a key is pressed.
# No background process, nothing to clean up: closing the tab ends it too.
cmd_play() {
  require_init
  local secs count img key name shown=0
  secs="$(parse_interval "${1:-5}")"
  [[ -n "$secs" ]] ||
    die "the interval must look like 5, 5s, 2m or 1h: ${1:-}" "间隔要写成 5、5s、2m 或 1h 这样：${1:-}"
  [[ -t 0 ]] ||
    die "the slideshow needs a terminal (it stops when you press a key)." "轮播要在终端里运行（按任意键停止）。"
  count="$(list_images | grep -c . || true)"
  (( count >= 2 )) ||
    die "the slideshow needs at least 2 images — add more with: bgs add <image or folder>" \
        "轮播至少要 2 张图——先多加几张：bgs add <图片或文件夹>"

  msg "Slideshow: a random image every ${secs}s. Press any key to stop." \
      "轮播中：每 ${secs} 秒随机换一张，按任意键停止。"
  trap 'printf "\n"; exit 0' INT TERM

  while true; do
    # One round = every image once, in random order; the image showing right now
    # is skipped, so a new round never starts with a repeat.
    while IFS= read -r img; do
      [[ -f "$img" && "$img" != "$(current_image)" ]] || continue
      write_include "$img" "$(managed_opacity)"
      reload_ghostty
      shown=$((shown + 1))
      name="$(basename "$img")"
      printf '\r\033[K  ▶ %s' "$name"
      # read -t waits for the interval; a key press ends the slideshow.
      # </dev/tty: the loop's own stdin is the image list.
      if IFS= read -r -s -n 1 -t "$secs" key </dev/tty; then
        printf '\r\033[K'
        msg "Stopped on: $name  ($shown shown)" "已停在：${name}（共换了 ${shown} 张）"
        return 0
      fi
    done < <(list_images | sort -R)
  done
}

cmd_pick() {
  require_init
  command -v fzf >/dev/null ||
    die "fzf is needed for the picker (brew install fzf), or use: ghostty-bg next" \
        "挑图需要 fzf（brew install fzf），或者用：ghostty-bg next"
  [[ -n "$(list_images)" ]] || empty_library
  # Preview with chafa only if it actually runs (a Homebrew upgrade can break its libraries).
  local preview='echo {}'
  if command -v chafa >/dev/null && chafa --version >/dev/null 2>&1; then
    local fmt=''
    # Inside Ghostty, the kitty graphics protocol gives a sharp preview instead of blocks.
    [[ "${TERM_PROGRAM:-}" == "ghostty" ]] && fmt='--format=kitty'
    preview="chafa $fmt --size=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES} {}"
  fi
  local choice prompt
  prompt="$(msg 'background> ' '背景图> ')"
  choice="$(list_images | fzf --prompt="$prompt" --preview "$preview" \
              --preview-window=right:65% --with-nth=-1 --delimiter=/)" || exit 0
  set_image "$choice"
}

cmd_list() {
  require_init
  local cur img
  cur="$(current_image)"
  while IFS= read -r img; do
    if [[ "$img" == "$cur" ]]; then echo "* $(basename "$img")"; else echo "  $(basename "$img")"; fi
  done < <(list_images)
}

cmd_off() {
  require_init
  local cur
  cur="$(current_image)"
  [[ -n "$cur" ]] || cur="$(hidden_image)"   # already off: keep remembering the same image
  write_include "" "$(managed_opacity)" "$cur"
  reload_ghostty
  msg "Background image is hidden. (bgh or bgs on brings it back)" \
      "背景图已隐藏。（再按 bgh 或 bgs on 恢复）"
}

# Show the image that was hidden; if it is gone, the first image in the library.
cmd_on() {
  require_init
  local img
  img="$(current_image)"
  if [[ -n "$img" && -f "$img" ]]; then
    msg "The background is already showing: $(basename "$img")" "背景图本来就在显示：$(basename "$img")"
    return
  fi
  img="$(hidden_image)"
  [[ -n "$img" && -f "$img" ]] || img="$(list_images | head -1)"
  [[ -n "$img" ]] || empty_library
  set_image "$img"
}

# bgh: hide the background image, or bring it back if it is hidden.
cmd_toggle() {
  require_init
  if [[ -n "$(current_image)" ]]; then cmd_off; else cmd_on; fi
}

OPACITY_STEP="0.05"

# bgs opacity            show the current value
# bgs opacity <0..1>     set it
# bgs opacity + | -      step it up / down by OPACITY_STEP
cmd_opacity() {
  require_init
  local arg="${1:-}" cur new
  cur="$(effective_opacity)"
  if [[ -z "$arg" ]]; then
    msg "Background image opacity: $cur   (bg+ / bg- to adjust, or: bgs opacity 0.3)" \
        "背景图浓度：$cur   （bg+ / bg- 调整，或者：bgs opacity 0.3）"
    return
  fi
  case "$arg" in
    +) new="$(awk -v c="$cur" -v s="$OPACITY_STEP" 'BEGIN { v = c + s; if (v > 1) v = 1; printf "%.2f", v }')" ;;
    -) new="$(awk -v c="$cur" -v s="$OPACITY_STEP" 'BEGIN { v = c - s; if (v < 0) v = 0; printf "%.2f", v }')" ;;
    *)
      [[ "$arg" =~ ^[0-9]*\.?[0-9]+$ ]] && awk -v v="$arg" 'BEGIN { exit !(v >= 0 && v <= 1) }' ||
        die "opacity must be a number from 0 to 1, or + / -: $arg" "浓度要是 0 到 1 之间的数字，或者 + / -：$arg"
      new="$(awk -v v="$arg" 'BEGIN { printf "%.2f", v }')" ;;
  esac
  # Tidy the number: 0.30 -> 0.3, 1.00 -> 1, 0.00 -> 0.
  new="$(awk -v v="$new" 'BEGIN { printf "%g", v }')"
  write_include "$(current_image)" "$new" "$(hidden_image)"
  reload_ghostty
  msg "Background image opacity: $cur -> $new" "背景图浓度：$cur -> $new"
}

# Move a file to the macOS Trash, so a mistaken delete can be undone from Finder.
to_trash() {
  if command -v trash >/dev/null; then
    trash -s "$1"
  else
    # Older macOS without /usr/bin/trash: move it into ~/.Trash ourselves.
    local base dest
    base="$(basename "$1")"
    dest="$HOME/.Trash/$base"
    [[ -e "$dest" ]] && dest="$HOME/.Trash/$(date +%Y%m%d_%H%M%S)-$base"
    mkdir -p "$HOME/.Trash" && mv "$1" "$dest"
  fi
}

# Resolve a name from `bgs list` (or a path inside the library) to a library file.
resolve_library_image() {
  local arg="$1" path
  if [[ "$arg" == */* ]]; then
    path="$(cd "$(dirname "$arg")" 2>/dev/null && pwd)/$(basename "$arg")"
    [[ "$(dirname "$path")" == "$LIB_DIR" ]] || return 1
  else
    path="$LIB_DIR/$arg"
  fi
  [[ -f "$path" ]] && is_image "$path" && echo "$path"
}

# bgs rm <name>...    move these library images to the Trash
# bgs rm              pick images with fzf (Tab to select several)
# bgs rm --current    the current background (used by bgd)
# Only the library copy is removed; the original photo you added is untouched.
cmd_rm() {
  require_init
  local before cur targets="" arg path removed=0 failed=0

  before="$(list_images)"
  [[ -n "$before" ]] || empty_library
  cur="$(current_image)"

  if [[ "${1:-}" == "--current" ]]; then
    [[ -n "$cur" && -f "$cur" ]] ||
      die "no background image is set right now." "现在没有设置背景图。"
    targets="$cur"
  elif (( $# == 0 )); then
    command -v fzf >/dev/null ||
      die "name the images to remove (see: bgs list), or install fzf to pick them" \
          "请写出要删的图片名（见 bgs list），或者装上 fzf 来挑选"
    local preview='echo {}' prompt
    if command -v chafa >/dev/null && chafa --version >/dev/null 2>&1; then
      local fmt=''
      [[ "${TERM_PROGRAM:-}" == "ghostty" ]] && fmt='--format=kitty'
      preview="chafa $fmt --size=\${FZF_PREVIEW_COLUMNS}x\${FZF_PREVIEW_LINES} {}"
    fi
    prompt="$(msg 'remove (Tab = select several)> ' '删除（Tab 多选）> ')"
    targets="$(printf '%s\n' "$before" | fzf --multi --prompt="$prompt" --preview "$preview" \
                 --preview-window=right:65% --with-nth=-1 --delimiter=/)" || exit 0
  else
    for arg in "$@"; do
      if path="$(resolve_library_image "$arg")"; then
        targets="$targets$path"$'\n'
      else
        msg "  not in the library: $arg   (see: bgs list)" "  图库里没有：$arg   （见 bgs list）"
        failed=$((failed + 1))
      fi
    done
  fi

  while IFS= read -r path; do
    [[ -n "$path" && -f "$path" ]] || continue
    if to_trash "$path"; then
      msg "  moved to Trash: $(basename "$path")" "  已移到废纸篓：$(basename "$path")"
      removed=$((removed + 1))
    else
      msg "  could not remove: $(basename "$path")" "  删除失败：$(basename "$path")"
      failed=$((failed + 1))
    fi
  done <<< "$targets"

  (( removed > 0 )) || die "nothing was removed." "没有删除任何图片。"

  # If the current background was removed, move on to the next remaining image
  # (in list order, wrapping around), or turn the background off if none are left.
  if [[ -n "$cur" && ! -f "$cur" ]]; then
    local next="" seen=0 img
    while IFS= read -r img; do
      if (( seen )) && [[ -f "$img" ]]; then next="$img"; break; fi
      [[ "$img" == "$cur" ]] && seen=1
    done <<< "$before"
    if [[ -z "$next" ]]; then
      while IFS= read -r img; do
        if [[ -f "$img" ]]; then next="$img"; break; fi
      done <<< "$before"
    fi
    if [[ -n "$next" ]]; then
      set_image "$next"
    else
      write_include "" "$(managed_opacity)"
      reload_ghostty
      msg "The library is empty now, so the background image is off." "图库已经空了，背景图已关闭。"
    fi
  fi

  if (( failed > 0 )); then exit 1; fi
}

# The bgm card, in the same style as the bgf browser. Each row is drawn as an
# empty card row first, then every piece is placed at an absolute column
# (ESC [ n G), so wide Chinese text needs no width maths.
# $1 width, $2 state (show / hidden / none / uninit), $3 image name,
# $4 opacity, $5 images in the library, $6 effect ("" = none).
menu_card() {
  local W="$1" cw line
  local card=$'\033[0;48;5;236;38;5;252m' dim=$'\033[0;48;5;236;38;5;244m'
  local edge=$'\033[0;48;5;236;38;5;240m' cmdc=$'\033[0;1;48;5;236;38;5;80m'
  local head=$'\033[0;48;5;236;38;5;73m' bold=$'\033[0;1;48;5;236;38;5;255m'
  line="$(printf '%*s' $(( W - 2 )) '' | sed 's/ /─/g')"
  cw=$(( (W - 14) / 3 ))

  rule()  { printf '  %s%s%s%s\033[0m\n' "$edge" "$1" "$line" "$2"; }
  blank() { printf '  %s│%s%*s%s│' "$edge" "$card" $(( W - 2 )) '' "$edge"; }
  col()   { printf '\033[%dG' "$(( 3 + $1 ))"; }
  # A row of commands: a section label, then up to three "command description"
  # cells. A command starting with "+" may run across the whole row.
  cells() {
    local label="$1" i=0 c d
    shift
    blank; col 2; printf '%s%s' "$head" "$label"
    while (( $# >= 2 )); do
      c="$1"; d="$2"; shift 2
      if [[ -n "$c" ]]; then
        col $(( 12 + i * cw )); printf '%s%s %s%s' "$cmdc" "${c#+}" "$card" "$d"
      fi
      i=$(( i + 1 ))
    done
    printf '\033[0m\n'
  }
  gap() { blank; printf '\033[0m\n'; }
  # The memo: letters in the command colour, their words dim.
  memo() {
    local pair
    blank; col 12
    for pair in "$@"; do printf '%s%s %s%s   ' "$cmdc" "${pair%%=*}" "$dim" "${pair#*=}"; done
    printf '\033[0m\n'
  }

  # Top edge with the title.
  printf '  %s╭─ %sghostty-bg %s%s %s' "$edge" "$head" "$dim" "$VERSION" "$edge"
  printf '%*s' $(( W - 16 - ${#VERSION} )) '' | sed 's/ /─/g'
  printf '╮\033[0m\n'

  # Status: what is showing, opacity, library size, effect.
  blank; col 2
  case "$2" in
    show)   printf '%s● %s%s' "$cmdc" "$bold" "$3" ;;
    hidden) printf '%s○ %s%s' "$dim" "$card" "$(msg "hidden ($3)" "已隐藏（$3）")" ;;
    none)   printf '%s○ %s' "$dim" "$(msg 'no image' '没有背景图')" ;;
    *)      printf '%s%s\033[0m\n' "$bold" "$(msg 'not set up yet — run: bgs init' '还没设置——请先运行：bgs init')"
            rule '╰' '╯'; return ;;
  esac
  printf '   %s%s %s%s' "$dim" "$(msg opacity 浓度)" "$card" "$4"
  printf '   %s%s %s%s' "$dim" "$(msg library 图库)" "$card" "$(msg "$5 images" "$5 张")"
  if [[ -n "$6" ]]; then printf '   %s%s %s%s' "$dim" "$(msg effect 特效)" "$card" "$6"
  else printf '   %s%s' "$dim" "$(msg 'no effect' '没开特效')"; fi
  printf '\033[0m\n'
  rule '├' '┤'

  if [[ "$UI_LANG" == zh ]]; then
    cells 换图 bgn 下一张 bgp 上一张 bgr 随机一张
    cells "" bgs '挑一张（fzf）' bga 自动轮播 bgv 欣赏模式
    gap
    cells 外观 bg+ 浓一点 bg- 淡一点 bgh '隐藏 / 显示'
    cells "" +bgf '特效 72 种：直接敲 bgf 用方向键挑 · bgf list 列出 · bgf off 关'
    cells "" +bgt '配色主题：直接敲 bgt 搜索着挑 · bgt here 只改这个 Tab'
    gap
    cells 图库 'bgs add' 加图或文件夹 bgd 删掉当前这张 'bgs rm' 按名字删
    cells "" 'bgs list' 列出全部
    gap
    cells 其他 bgw 文件在哪 bgm 这个菜单 'bgs help' 完整帮助
    rule '├' '┤'
    blank; col 2; printf '%s速记' "$head"; col 12; printf '%sbg = background，再加一个字母\033[0m\n' "$card"
    memo n=next p=previous r=random s=select h=hide d=delete
    memo w=where m=menu a=auto f=effects v=view t=theme +=浓 -=淡
  else
    cells switch bgn next bgp previous bgr random
    cells "" bgs 'pick (fzf)' bga slideshow bgv 'viewing mode'
    gap
    cells look bg+ stronger bg- fainter bgh 'hide / show'
    cells "" +bgf 'effects, 72 of them: plain bgf to browse · bgf list · bgf off'
    cells "" +bgt 'colour theme: plain bgt to search · bgt here for this tab only'
    gap
    cells library 'bgs add' 'add images' bgd 'delete current' 'bgs rm' 'remove by name'
    cells "" 'bgs list' 'list them all'
    gap
    cells more bgw where bgm 'this menu' 'bgs help' 'full help'
    rule '├' '┤'
    blank; col 2; printf '%smemo' "$head"; col 12; printf '%sbg = background, plus one letter\033[0m\n' "$card"
    memo n=next p=previous r=random s=select h=hide d=delete
    memo w=where m=menu a=auto f=effects v=view t=theme
    memo +=stronger -=fainter
  fi
  rule '╰' '╯'
}

# bgm: one-screen menu of the short commands, with the current state on top.
# A card on a wide terminal; plain text in a pipe or a narrow window.
cmd_menu() {
  local cur hid count state
  count=0

  # On a wide enough terminal: the card. Otherwise (a pipe, a narrow window): plain text.
  local cols
  cols="$({ stty size </dev/tty | cut -d' ' -f2; } 2>/dev/null || true)"
  if [[ -t 1 && "$cols" =~ ^[0-9]+$ ]] && (( cols >= 84 )); then
    local W=88 kind=uninit name="" fx="" f
    (( W <= cols - 4 )) || W=$(( cols - 4 ))
    if is_initialized; then
      cur="$(current_image)"; hid="$(hidden_image)"
      count="$(list_images | grep -c . || true)"
      if [[ -n "$cur" ]]; then kind=show; name="$(basename "$cur")"
      elif [[ -n "$hid" ]]; then kind=hidden; name="$(basename "$hid")"
      else kind=none; fi
      f="$(managed_fx)"
      if [[ -n "$f" && -f "$f" ]]; then
        fx="$(fx_name "$f")"
        [[ "$UI_LANG" == zh ]] && fx="$fx $(fx_label "$f")"
      fi
      # Long file names would run past the right edge.
      (( ${#name} <= 34 )) || name="${name:0:31}..."
    fi
    menu_card "$W" "$kind" "$name" "$(is_initialized && effective_opacity)" "$count" "$fx"
    return
  fi

  if is_initialized; then
    cur="$(current_image)"; hid="$(hidden_image)"
    count="$(list_images | grep -c . || true)"
    if [[ -n "$cur" ]]; then
      state="$(msg "showing $(basename "$cur")" "正在显示 $(basename "$cur")")"
    elif [[ -n "$hid" ]]; then
      state="$(msg "hidden ($(basename "$hid"))" "已隐藏（$(basename "$hid")）")"
    else
      state="$(msg "no image" "没有背景图")"
    fi
    local fx="" fxname
    fxname="$(managed_fx)"
    if [[ -n "$fxname" ]]; then fx="$(msg " · effect $(fx_name "$fxname")" " · 特效 $(fx_name "$fxname")")"; fi
    msg "ghostty-bg · $state · opacity $(effective_opacity) · $count in library$fx" \
        "ghostty-bg · $state · 浓度 $(effective_opacity) · 图库 $count 张$fx"
  else
    msg "ghostty-bg · not set up yet — run: bgs init" "ghostty-bg · 还没设置——请先运行：bgs init"
  fi
  echo
  if [[ "$UI_LANG" == zh ]]; then
    cat <<'EOF'
  换图   bgn  下一张      bgp  上一张      bgr  随机一张
         bgs  挑一张（fzf 预览）       bga  自动轮播，按任意键停
         bgv  欣赏模式：清屏只看图，画面慢慢动
  外观   bg+  浓一点      bg-  淡一点      bgh  隐藏 / 显示
         bgf  特效 8 类 × 9 种（bgf 用方向键挑，bgf list 列出，bgf off 关）
         bgt  配色主题（bgt 搜索着挑，bgt here 只改这个 Tab，bgt reset 恢复）
  图库   bgs add <图或文件夹>   加图        bgd  删掉当前这张
         bgs rm <名字>          删图        bgs list  列出
  其他   bgw  文件在哪    bgm  这个菜单    bgs help  完整帮助

  速记：bg = background，再加一个字母
        n next · p previous · r random · s select
        h hide · d delete · w where · m menu · a auto · f effects
        v view · t theme · + 浓 · - 淡
EOF
  else
    cat <<'EOF'
  switch   bgn  next        bgp  previous    bgr  random
           bgs  pick one (fzf preview)   bga  auto slideshow, any key stops
           bgv  viewing mode: just the picture, slowly moving
  look     bg+  stronger    bg-  fainter     bgh  hide / show
           bgf  effects, 8 sets of 9 (bgf to browse, bgf list, bgf off)
           bgt  colour theme (bgt to search and pick, bgt here for this tab only, bgt reset)
  library  bgs add <image or folder>  add   bgd  delete current
           bgs rm <name>              remove      bgs list  list
  more     bgw  where       bgm  this menu   bgs help  full help

  memo: bg = background, plus one letter
        n next · p previous · r random · s select
        h hide · d delete · w where · m menu · a auto · f effects
        v view · t theme · + stronger · - fainter
EOF
  fi
}

cmd_where() {
  local state
  if is_initialized; then
    state="$(msg ' (set up)' '（已设置）')"
  else
    state="$(msg ' (not set up — run: ghostty-bg init)' '（未设置——请运行：ghostty-bg init）')"
  fi
  msg "config file : $CONFIG_FILE$state" "配置文件：$CONFIG_FILE$state"
  msg "image folder: $LIB_DIR"            "图库目录：$LIB_DIR"
  msg "managed file: $BG_CONF"            "背景文件：$BG_CONF"
}

usage() {
  if [[ "$UI_LANG" == zh ]]; then
    cat <<'EOF'
ghostty-bg（简写 bgs）—— 一条命令切换 Ghostty 终端背景图（macOS）

用法（下面的 bgs 都可以写成 ghostty-bg）：
  bgs init          首次设置：接入你的 Ghostty 配置，建好图库目录
  bgs add <图片或文件夹>  复制进图库并设为背景（文件夹会加入里面所有 PNG/JPG）
                    竖图：装了 ImageMagick 会做成两边模糊的横版，否则完整显示
  bgs               用 fzf 挑一张（装了 chafa 会显示预览）
  bgs next | prev   下一张 / 上一张
  bgs random        随机一张
  bgs view          欣赏模式：切到空白屏幕只看图，画面像镜头一样慢慢推移；n / p / r 换图，其他键退出并恢复原样
  bgs play [间隔]   轮播：在前台每隔几秒随机换一张，按任意键停（默认 5 秒；可写 30s、5m）
  bgs list          列出图库，* 是当前这张
  bgs off | on      隐藏 / 恢复背景图（bgh 在两者之间切换）
  bgs fx [名字]     动态特效 8 类：天气 自然 动物 海洋 节日 太空 极客 奇幻。不写名字就进入浏览：← → 换一个，↑ ↓ 换一类，回车保留，Esc 恢复
                    list 列出全部；写类别名只看那一类；next / prev / random 换；off 关掉
  bgs theme [名字]  配色主题，只改当前外观（浅色 / 深色）用的那个。不写名字就进入浏览：装了 fzf 可以打字搜索，
                    光标移到哪个终端就换成哪个，回车保留，Esc 恢复；all 浏览全部；list 列出；random 随机；reset 恢复成你自己配置里的
                    bgs theme here [名字] 只改当前这个 Tab（不改配置、不影响别的 Tab，关掉 Tab 就没了）；here reset 恢复成全局主题
  bgs rm <名字>     把图库里的图移到废纸篓（不写名字就用 fzf 多选；原图不受影响）
  bgs opacity       查看背景图浓度；bgs opacity 0.3 设成 0.3；+ / - 每次加减 0.05
  bgs where         显示用到的配置文件和图库位置（= bgw）

快捷命令：bgn = 下一张，bgp = 上一张，bgr = 随机一张，bg+ = 浓一点，bg- = 淡一点，bgh = 隐藏/显示，bgw = 文件在哪，bgd = 删掉当前这张，bgm = 命令菜单，bga = 自动轮播，bgf = 特效，bgv = 欣赏模式，bgt = 主题

缩写怎么来的：bg = background（背景），后面一个字母是动作
  bgs  s = select    挑图          bgn  n = next      下一张
  bgp  p = previous  上一张        bgr  r = random    随机
  bgh  h = hide      隐藏/显示     bgd  d = delete    删掉当前这张
  bgw  w = where     文件在哪      bgm  m = menu      命令菜单
  bga  a = auto      自动轮播          bgf  f = effects   动态特效
  bgv  v = view      欣赏模式          bgt  t = theme     配色主题
  bg+  + = more      浓一点        bg-  - = less      淡一点

语言：GHOSTTY_BG_LANG=zh 或 en（默认跟随 LANG）
竖图不做模糊：GHOSTTY_BG_BLUR=0
EOF
  else
    cat <<'EOF'
ghostty-bg (short: bgs) — switch the Ghostty terminal background image with one command (macOS)

Usage (bgs and ghostty-bg are the same command):
  bgs init          one-time setup: hook into your Ghostty config, create the image folder
  bgs add <image or folder>  copy into the library and use it (a folder adds every PNG/JPG in it)
                    narrow images: widened with blurred sides if ImageMagick is installed, else shown whole
  bgs               pick an image with fzf (preview via chafa, if installed)
  bgs next | prev   switch to the next / previous image
  bgs random        switch to a random image
  bgs view          viewing mode: a blank screen with just the picture, drifting like a slow camera; n / p / r change it, any other key leaves and restores everything
  bgs play [time]   slideshow in the foreground: a random image every few seconds, any key stops (default 5s; 30s, 5m)
  bgs list          list the library, * marks the current image
  bgs off | on      hide / bring back the background image (bgh toggles)
  bgs fx [name]     animated effects in 8 categories: weather nature animals ocean festival space geek fantasy. No name: browse them (← → effect, ↑ ↓ category, Enter keeps, Esc undoes)
                    list shows them all; a category shows just that one; next / prev / random switch; off stops
  bgs theme [name]  colour theme, only for the current appearance (light / dark). No name: browse them (with fzf you can
                    type to search; the terminal recolours as you move; Enter keeps, Esc undoes); all browses every theme;
                    list, random; reset goes back to the theme in your own config
                    bgs theme here [name] only this tab (no config change, other tabs untouched, gone when the tab closes); here reset
  bgs rm <name>     move library images to the Trash (no name: pick with fzf; originals untouched)
  bgs opacity       show the image opacity; bgs opacity 0.3 sets it; + / - step by 0.05
  bgs where         show which files ghostty-bg uses (= bgw)

Shortcuts: bgn = next, bgp = previous, bgr = random, bg+ = stronger, bg- = fainter, bgh = hide/show, bgw = where, bgd = delete the current image, bgm = command menu, bga = auto slideshow, bgf = effects, bgv = viewing mode, bgt = theme

Where the names come from: bg = background, plus one letter for the action
  bgs  s = select    pick one      bgn  n = next      next image
  bgp  p = previous  previous      bgr  r = random    random image
  bgh  h = hide      hide / show   bgd  d = delete    delete current
  bgw  w = where     file places   bgm  m = menu      command menu
  bga  a = auto      auto slideshow bgf  f = effects   animated effect
  bgv  v = view      viewing mode   bgt  t = theme     colour theme
  bg+  + = more      stronger      bg-  - = less      fainter

Language: GHOSTTY_BG_LANG=zh or en (default: follows LANG)
No blurred sides for narrow images: GHOSTTY_BG_BLUR=0
EOF
  fi
}

# With no arguments: open the picker if set up, otherwise explain how to start.
pick_or_help() {
  if is_initialized; then
    cmd_pick
  else
    usage
    echo
    die "not set up yet — run: ghostty-bg init" "还没设置——请先运行：ghostty-bg init"
  fi
}

main() {
  case "${1:-}" in
    "")                pick_or_help ;;
    init)              cmd_init ;;
    add)               shift; cmd_add "$@" ;;
    next|prev|random)  cmd_step "$1" ;;
    play|slideshow)    shift; cmd_play "${1:-}" ;;
    view)              cmd_view ;;
    list|ls)           cmd_list ;;
    off|hide)          cmd_off ;;
    on|show)           cmd_on ;;
    toggle)            cmd_toggle ;;
    menu)              cmd_menu ;;
    fx|effect)         shift; cmd_fx "${1:-}" ;;
    theme)             shift; cmd_theme "$@" ;;
    _theme-apply)      shift; theme_apply "$1" ;;      # used by the fzf browser (THEME_HERE passes through)
    _theme-sample)     theme_sample ;;
    rm|remove|delete)  shift; cmd_rm "$@" ;;
    opacity)           shift; cmd_opacity "${1:-}" ;;
    where)             cmd_where ;;
    -v|--version)      echo "ghostty-bg $VERSION" ;;
    -h|--help|help)    usage ;;
    *)
      # Shortcut: `ghostty-bg <image|folder>` works like `ghostty-bg add <image|folder>`.
      if [[ -f "$1" || -d "$1" ]]; then cmd_add "$@"; else usage; exit 1; fi ;;
  esac
}

main "$@"
